---
import ArticleCard from '../../../components/ArticleCard.astro';
import Base from '../../../layouts/Base.astro';
import { allArticles } from '../../../lib/articles';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { LOCALES, PILLARS, SITE_NAME, SITE_URL, t, type Locale, type Pillar } from '../../../lib/site';

export async function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    (Object.keys(PILLARS) as Pillar[]).map((pillar) => ({
      params: { locale, pillar: PILLARS[pillar].slug[locale] },
      props: { pillarKey: pillar },
    }))
  );
}

const locale = Astro.params.locale as Locale;
const { pillarKey } = Astro.props;
const pillar = PILLARS[pillarKey as Pillar];

const all = (await allArticles()).filter((e) => e.data.locale === locale);
const entries = all
  .filter((e) => e.data.pillar === pillarKey)
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const countOf = (p: Pillar) => all.filter((e) => e.data.pillar === p).length;

const path = `/${locale}/${pillar.slug[locale]}/`;
const alternates = Object.fromEntries(LOCALES.map((l) => [l, `/${l}/${pillar.slug[l]}/`]));
const jsonLd = [
  breadcrumbJsonLd([
    { name: t('home', locale), url: `${SITE_URL}/${locale}/` },
    { name: pillar.name[locale], url: SITE_URL + path },
  ]),
];
---

<Base
  locale={locale}
  title={`${pillar.name[locale]} — ${SITE_NAME}`}
  description={pillar.intro[locale]}
  path={path}
  alternates={alternates}
  jsonLd={jsonLd}
  wide
>
  <p class="eyebrow text-accent-ink">{SITE_NAME}.nl</p>
  <h1 class="display-hero mt-3 text-[clamp(2.8rem,8vw,5rem)]">{pillar.name[locale]}</h1>
  <p class="mt-5 max-w-xl text-xl leading-snug text-ink-muted">{pillar.intro[locale]}</p>

  <div class="mt-8 flex flex-wrap gap-2">
    {(Object.keys(PILLARS) as Pillar[]).map((p) => (
      <a
        href={`/${locale}/${PILLARS[p].slug[locale]}/`}
        class:list={['chip', p === pillarKey && 'chip-active']}
      >
        {PILLARS[p].name[locale]}
        <span class="count">{countOf(p)}</span>
      </a>
    ))}
  </div>

  <div class="mt-12 grid gap-5 sm:grid-cols-2">
    {entries.map((a) => (
      <ArticleCard article={a} />
    ))}
  </div>
</Base>
