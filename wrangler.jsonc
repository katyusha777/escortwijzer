{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pure static-assets Worker: no `main`, dist is served directly.
  "name": "best-escorts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "best-escorts-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
