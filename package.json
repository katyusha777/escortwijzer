{
  "name": "best-escorts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "verify": "bun scripts/verify.ts",
    "preview": "astro build && wrangler dev",
    "deploy:staging": "astro build && bun scripts/verify.ts && wrangler deploy --env staging",
    "deploy": "astro build && bun scripts/verify.ts && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.3.14",
    "sharp": "^0.34.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.116.0"
  }
}
