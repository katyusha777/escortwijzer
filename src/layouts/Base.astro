---
import '../styles/global.css';
import {
  LOCALES,
  PILLARS,
  SITE_NAME,
  SITE_URL,
  htmlLang,
  t,
  type Locale,
} from '../lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page, with trailing slash, e.g. /nl/wetgeving/is-escort-legaal/ */
  path: string;
  /** Locale → path map for hreflang + the locale switcher. Includes self. */
  alternates: Partial<Record<Locale, string>>;
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  /** Wider container for grid pages (home, hubs) */
  wide?: boolean;
}

const {
  locale,
  title,
  description,
  path,
  alternates,
  jsonLd = [],
  ogType = 'website',
  wide = false,
} = Astro.props;
const canonical = SITE_URL + path;
const xDefault = alternates.nl ?? path;
const currentPillarSlug = path.split('/')[2] ?? '';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([l, p]) => (
      <link rel="alternate" hreflang={l} href={SITE_URL + p} />
    ))}
    <link rel="alternate" hreflang="x-default" href={SITE_URL + xDefault} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/og/default.png`} />
    <meta property="og:locale" content={locale === 'nl' ? 'nl_NL' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f6f1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17150f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/fraunces-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body class="min-h-dvh bg-paper text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper focus:px-3 focus:py-2"
    >
      {t('skipToContent', locale)}
    </a>

    <header class="px-3 pt-3 sm:px-4 sm:pt-4">
      <div class="mx-auto max-w-6xl rounded-[1.75rem] bg-band text-band-ink">
        <div class="flex items-center justify-between gap-4 px-5 pt-4 sm:px-7">
          <a href={`/${locale}/`} class="display text-[1.35rem] tracking-tight">
            {SITE_NAME}<span class="text-accent">.nl</span>
          </a>
          <nav aria-label="Language" class="flex gap-1.5">
            {LOCALES.map((l) => (
              <a
                href={alternates[l] ?? `/${l}/`}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'chip chip-sm chip-band uppercase tracking-wider',
                  l === locale && 'chip-active',
                ]}
              >
                {l}
              </a>
            ))}
          </nav>
        </div>
        <nav
          aria-label="Sections"
          class="flex gap-2 overflow-x-auto px-5 pb-4 pt-3 sm:px-7 [scrollbar-width:none]"
        >
          {Object.entries(PILLARS).map(([key, p]) => (
            <a
              href={`/${locale}/${p.slug[locale]}/`}
              class:list={[
                'chip chip-band',
                p.slug[locale] === currentPillarSlug && 'chip-active',
              ]}
            >
              {p.name[locale]}
            </a>
          ))}
          <a href={t('aboutPath', locale)} class="chip chip-band">{t('about', locale)}</a>
        </nav>
      </div>
    </header>

    <main
      id="main"
      class:list={['mx-auto px-5', wide ? 'max-w-6xl py-10 sm:py-14' : 'max-w-3xl py-10']}
    >
      <slot />
    </main>

    <footer class="px-3 pb-3 sm:px-4 sm:pb-4">
      <div class="mx-auto max-w-6xl rounded-[1.75rem] bg-band text-band-ink px-5 py-10 sm:px-10 sm:py-14">
        <p class="display-hero text-[clamp(2.6rem,9vw,6rem)]">
          {SITE_NAME}<span class="text-accent">.nl</span>
        </p>
        <p class="mt-4 max-w-md text-band-muted leading-snug">{t('tagline', locale)}</p>
        <div class="mt-10 grid gap-8 sm:grid-cols-3">
          <nav aria-label="Pillars" class="grid gap-2 font-sans text-[0.9rem]">
            {Object.values(PILLARS).map((p) => (
              <a href={`/${locale}/${p.slug[locale]}/`} class="text-band-muted hover:text-band-ink">
                {p.name[locale]}
              </a>
            ))}
          </nav>
          <nav aria-label="Meta" class="grid gap-2 font-sans text-[0.9rem] content-start">
            <a href={t('aboutPath', locale)} class="text-band-muted hover:text-band-ink">
              {t('about', locale)}
            </a>
            <a
              href={`/${locale}/platforms/${locale === 'nl' ? 'methodologie' : 'methodology'}/`}
              class="text-band-muted hover:text-band-ink"
            >
              {locale === 'nl' ? 'Methodologie' : 'Methodology'}
            </a>
          </nav>
          <p class="font-sans text-[0.78rem] leading-relaxed text-band-muted">
            {t('footerDisclosure', locale)}
          </p>
        </div>
        <p class="mt-10 border-t border-band-ink/15 pt-5 font-sans text-[0.75rem] text-band-muted">
          © {new Date().getFullYear()} {SITE_NAME} · best-escorts.nl
        </p>
      </div>
    </footer>
  </body>
</html>
