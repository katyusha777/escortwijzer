---
import Base from '../layouts/Base.astro';
import { t } from '../lib/site';

// Single 404 (CF serves /404.html for all misses); bilingual body.
---

<Base
  locale="nl"
  title="404 — Best Escorts"
  description={t('notFound', 'nl')}
  path="/404/"
  alternates={{}}
>
  <h1 class="display-hero text-[clamp(5rem,20vw,10rem)] text-accent">404</h1>
  <p class="mt-6 text-lg">{t('notFoundBody', 'nl')} <a class="underline underline-offset-4" href="/nl/">→ Homepage</a></p>
  <p class="mt-2 text-lg text-ink-muted">{t('notFoundBody', 'en')} <a class="underline underline-offset-4" href="/en/">→ Homepage</a></p>
</Base>
